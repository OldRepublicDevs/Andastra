<!--
  Monaco / VS Code Dark+ theme - 1:1 color parity with VS Code's default dark theme.
  Colors from: https://github.com/microsoft/vscode/blob/main/extensions/theme-defaults/themes/dark_vs.json
  and dark_plus.json
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:OdyTools.Widgets;assembly=OdyTools">

  <!-- Monaco line numbers margin - VS Code Dark+ styling (Background/Foreground set in code via MonacoColors) -->
  <Style Selector="widgets|MonacoLineNumbersMargin">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, Monaco, monospace"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>

  <!-- Monaco status bar -->
  <Style Selector="Border.monaco-status-bar">
    <Setter Property="Background" Value="#007ACC"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <!-- Monaco sidebar / activity bar -->
  <Style Selector="Border.monaco-activity-bar">
    <Setter Property="Background" Value="#333333"/>
    <Setter Property="MinWidth" Value="48"/>
  </Style>

  <!-- Monaco panel (output, terminal); Border has no Foreground, set text color on child controls -->
  <Style Selector="Border.monaco-panel">
    <Setter Property="Background" Value="#252526"/>
  </Style>

</Styles>
