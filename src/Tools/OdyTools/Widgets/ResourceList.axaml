<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="using:OdyTools.Widgets"
             x:Class="OdyTools.Widgets.ResourceList">
    <UserControl.Styles>
        <Style Selector="TreeView#resourceTree">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DBE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="TreeView#resourceTree TreeViewItem">
            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TreeView#resourceTree Border.resource-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TreeView#resourceTree TreeViewItem:pointerover Border.resource-item">
            <Setter Property="Background" Value="#E8EAED" />
            <Setter Property="BorderBrush" Value="#1A73E8" />
        </Style>
        <Style Selector="TreeView#resourceTree TreeViewItem:selected Border.resource-item">
            <Setter Property="Background" Value="#E3F2FD" />
            <Setter Property="BorderBrush" Value="#1A73E8" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Section Combo and Refresh Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="5">
            <ComboBox Name="sectionCombo" Grid.Column="0" Margin="0,0,5,0" />
            <Button Name="refreshButton" Grid.Column="1" Content="Refresh" Width="70" ToolTip.Tip="Refresh this list." />
        </Grid>

        <!-- Search and Reload -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="5,0,5,5">
            <TextBox Name="searchEdit" Grid.Column="0" Watermark="search..." Margin="0,0,5,0" />
            <Button Name="reloadButton" Grid.Column="1" Content="Reload" Width="70" ToolTip.Tip="Reload the active module/folder." />
        </Grid>

        <!-- Resource Tree (SelectionMode.Multiple matches PyKotor ExtendedSelection; context menu via ContextRequested) -->
        <TreeView Name="resourceTree" Grid.Row="2" SelectionMode="Multiple">
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="widgets:ResourceTreeNode" ItemsSource="{Binding Children}">
                    <Border Classes="resource-item" Padding="6,4" Margin="2,0,4,0" CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="#1A73E8"
                                    IsVisible="{Binding IsCategory}" />
                            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="#3C4043"
                                    IsVisible="{Binding IsResourceNode}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="{Binding TitleFontWeight}"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Padding="6,1"
                                    CornerRadius="8"
                                    Background="#E8EAED"
                                    IsVisible="{Binding IsCategory}">
                                <TextBlock FontSize="11" Foreground="#202124" Text="{Binding ItemCountLabel}" />
                            </Border>
                        </Grid>
                    </Border>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
