<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OdyTools.Widgets.MediaPlayerWidget"
             MinHeight="72"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Button.transport">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Cursor" Value="Pointer"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="#202124"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.transport:pointerover">
      <Setter Property="Background" Value="#E3F2FD"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.transport:pressed">
      <Setter Property="Background" Value="#E8EAED"/>
    </Style>
    <Style Selector="Button.transport:disabled">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Slider.progress">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Value" Value="0"/>
    </Style>
    <Style Selector="Slider.volume">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Width" Value="72"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Value" Value="75"/>
    </Style>
    <Style Selector="TextBlock.time">
      <Setter Property="FontFamily" Value="Consolas, 'Segoe UI', sans-serif"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#202124"/>
      <Setter Property="Opacity" Value="0.9"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <Border Background="#FAFBFC"
          BorderBrush="#D7DBE6"
          BorderThickness="0,1,0,0"
          Padding="20,14"
          CornerRadius="0">

    <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

      <!-- Play / Pause -->
      <Button x:Name="playPauseButton"
              Grid.Column="0"
              Grid.Row="0"
              Content="▶"
              ToolTip.Tip="Play / Pause (Space)"
              Classes="transport"/>

      <!-- Stop -->
      <Button x:Name="stopButton"
              Grid.Column="1"
              Grid.Row="0"
              Content="■"
              ToolTip.Tip="Stop (S)"
              Margin="2,0,0,0"
              Classes="transport"/>

      <!-- Progress slider -->
      <Slider x:Name="timeSlider"
              Grid.Column="2"
              Grid.Row="0"
              Margin="16,0"
              VerticalAlignment="Center"
              ToolTip.Tip="Seek"
              Classes="progress"/>

      <!-- Time display -->
      <TextBlock x:Name="timeLabel"
                 Grid.Column="3"
                 Grid.Row="0"
                 Text="0:00 / 0:00"
                 Margin="12,0"
                 Classes="time"
                 VerticalAlignment="Center"/>

      <!-- Volume: mute + slider -->
      <StackPanel Grid.Column="4"
                  Grid.Row="0"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center">
        <Button x:Name="muteButton"
                Content="🔊"
                ToolTip.Tip="Mute (M)"
                Width="32" Height="32"
                Padding="0"
                FontSize="14"
                Classes="transport"/>
        <Slider x:Name="volumeSlider"
                VerticalAlignment="Center"
                ToolTip.Tip="Volume"
                Classes="volume"/>
      </StackPanel>

      <!-- Speed -->
      <Button x:Name="speedButton"
              Grid.Column="5"
              Grid.Row="0"
              Content="1.0×"
              MinWidth="48"
              Height="28"
              FontSize="12"
              Padding="8,4"
              ToolTip.Tip="Speed ([ ] to change)"
              VerticalAlignment="Center"
              Margin="8,0,0,0"
              Classes="transport"/>
    </Grid>
  </Border>
</UserControl>
