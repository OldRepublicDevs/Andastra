<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:OdyTools.Widgets"
        xmlns:widgets="clr-namespace:OdyTools.Widgets.Edit"
        x:Class="OdyTools.Editors.OdyToolUTT"
        Title="OdyToolUTT"
        MinWidth="700" MinHeight="500"
        Width="900" Height="600"
        RequestedThemeVariant="Light">
  <Window.Styles>
    <Style Selector="Window">
      <Setter Property="Background" Value="#F3F5F9" />
    </Style>
  </Window.Styles>
  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top" Name="menuBar">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Name="actionNew"/>
        <MenuItem Header="_Open" Name="actionOpen"/>
        <MenuItem Header="_Save" Name="actionSave"/>
        <MenuItem Header="Save _As" Name="actionSaveAs"/>
        <Separator/>
        <MenuItem Header="_Revert" Name="actionRevert"/>
        <Separator/>
        <MenuItem Header="E_xit" Name="actionExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Name="actionUndo"/>
        <MenuItem Header="_Redo" Name="actionRedo"/>
        <Separator/>
        <MenuItem Header="Find..." Name="actionFind"/>
        <MenuItem Header="Find _Next" Name="actionFindNext"/>
      </MenuItem>
      <MenuItem Header="_Help" Name="menuHelp"/>
    </Menu>

    <TabControl Name="editorSurface" Margin="10">
      <TabItem Header="Basic">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="10" RowSpacing="8" Margin="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
          <w:LocalizedStringEdit Name="nameEdit" Grid.Row="0" Grid.Column="1"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Tag" VerticalAlignment="Center"/>
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="tagEdit"/>
            <Button Name="tagGenerateButton" Grid.Column="1" Content="Use ResRef"/>
          </Grid>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Template ResRef" VerticalAlignment="Center"/>
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="resrefEdit" MaxLength="16"/>
            <Button Name="resrefGenerateButton" Grid.Column="1" Content="Use file name"/>
          </Grid>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Type" VerticalAlignment="Center"/>
          <ComboBox Name="typeSelect" Grid.Row="3" Grid.Column="1">
            <ComboBoxItem Content="Generic"/>
            <ComboBoxItem Content="Transition"/>
            <ComboBoxItem Content="Trap"/>
          </ComboBox>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Cursor" VerticalAlignment="Center"/>
          <widgets:ComboBox2DA Name="cursorSelect" Grid.Row="4" Grid.Column="1"/>
        </Grid>
      </TabItem>

      <TabItem Header="Advanced">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="10" RowSpacing="8" Margin="8">
          <CheckBox Name="autoRemoveKeyCheckbox" Grid.Row="0" Grid.Column="1" Content="Auto Remove Key"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Key Name" VerticalAlignment="Center"/>
          <TextBox Name="keyEdit" Grid.Row="1" Grid.Column="1"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Faction" VerticalAlignment="Center"/>
          <widgets:ComboBox2DA Name="factionSelect" Grid.Row="2" Grid.Column="1"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Highlight Height" VerticalAlignment="Center"/>
          <NumericUpDown Name="highlightHeightSpin" Grid.Row="3" Grid.Column="1" Minimum="-10000" Maximum="10000"/>
        </Grid>
      </TabItem>

      <TabItem Header="Trap">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="10" RowSpacing="8" Margin="8">
            <CheckBox Name="isTrapCheckbox" Grid.Row="0" Grid.Column="1" Content="Is a trap"/>
            <CheckBox Name="activateOnceCheckbox" Grid.Row="1" Grid.Column="1" Content="Activate Once"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Trap Type" VerticalAlignment="Center"/>
            <widgets:ComboBox2DA Name="trapSelect" Grid.Row="2" Grid.Column="1"/>
            <CheckBox Name="detectableCheckbox" Grid.Row="3" Grid.Column="1" Content="Detectable"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Detect DC" VerticalAlignment="Center"/>
            <NumericUpDown Name="detectDcSpin" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255"/>
            <CheckBox Name="disarmableCheckbox" Grid.Row="5" Grid.Column="1" Content="Disarmable"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Disarm DC" VerticalAlignment="Center"/>
            <NumericUpDown Name="disarmDcSpin" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="255"/>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Scripts">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="OnClick" VerticalAlignment="Center"/>
            <ComboBox Name="onClickEdit" Grid.Row="0" Grid.Column="1" IsEditable="True"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="OnDisarm" VerticalAlignment="Center"/>
            <ComboBox Name="onDisarmEdit" Grid.Row="1" Grid.Column="1" IsEditable="True"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="OnEnter" VerticalAlignment="Center"/>
            <ComboBox Name="onEnterSelect" Grid.Row="2" Grid.Column="1" IsEditable="True"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="OnExit" VerticalAlignment="Center"/>
            <ComboBox Name="onExitSelect" Grid.Row="3" Grid.Column="1" IsEditable="True"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="OnHeartbeat" VerticalAlignment="Center"/>
            <ComboBox Name="onHeartbeatSelect" Grid.Row="4" Grid.Column="1" IsEditable="True"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="OnTrapTriggered" VerticalAlignment="Center"/>
            <ComboBox Name="onTrapTriggeredEdit" Grid.Row="5" Grid.Column="1" IsEditable="True"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="OnUserDefined" VerticalAlignment="Center"/>
            <ComboBox Name="onUserDefinedSelect" Grid.Row="6" Grid.Column="1" IsEditable="True"/>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Comments">
        <TextBox Name="commentsEdit" Margin="8" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"/>
      </TabItem>
    </TabControl>

    <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#E8EAED" BorderBrush="#DADCE0" BorderThickness="0,1,0,0">
      <TextBlock Name="statusText" Text="Trigger" Foreground="#202124" FontSize="12"/>
    </Border>
  </DockPanel>
</Window>
