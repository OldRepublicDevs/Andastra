<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:OdyTools.Widgets"
        x:Class="OdyTools.Editors.OdyToolIFO"
        Title="OdyToolIFO"
        MinWidth="640" MinHeight="480"
        Width="900" Height="620"
        RequestedThemeVariant="Light">
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="#F3F5F9" />
        </Style>
        <Style Selector="Menu">
            <Setter Property="Background" Value="#F1F3F4" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="BorderBrush" Value="#D7DBE6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="#202124" />
        </Style>
        <Style Selector="Menu MenuItem">
            <Setter Property="Foreground" Value="#202124" />
        </Style>
        <Style Selector="Button.command">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#202124" />
        </Style>
        <Style Selector="Button.command:pointerover">
            <Setter Property="Background" Value="#E8EAED" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DBE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#3C4043" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBlock#statusText">
            <Setter Property="Foreground" Value="#202124" />
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Name="menuBar">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Name="actionNew" ToolTip.Tip="Create a new empty module info."/>
                <MenuItem Header="_Open" Name="actionOpen" ToolTip.Tip="Open an IFO file from disk or from a game resource."/>
                <MenuItem Header="_Save" Name="actionSave" HotKey="Ctrl+S" ToolTip.Tip="Save the current module info."/>
                <MenuItem Header="Save _As" Name="actionSaveAs" ToolTip.Tip="Save the module info to a new file."/>
                <Separator/>
                <MenuItem Header="_Revert" Name="actionRevert" ToolTip.Tip="Discard unsaved changes and reload from disk."/>
                <Separator/>
                <MenuItem Header="E_xit" Name="actionExit" ToolTip.Tip="Close OdyToolIFO."/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Name="actionUndo" HotKey="Ctrl+Z" ToolTip.Tip="Undo the last change."/>
                <MenuItem Header="_Redo" Name="actionRedo" HotKey="Ctrl+Y" ToolTip.Tip="Redo the last undone change."/>
                <Separator/>
                <MenuItem Header="_Find..." Name="actionFind" HotKey="Ctrl+F" ToolTip.Tip="Search in tag, scripts, and other fields."/>
                <MenuItem Header="Find _Next" Name="actionFindNext" HotKey="F3" ToolTip.Tip="Jump to the next match."/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="8,6" Background="#FAFBFC" BorderBrush="#E1E5EB" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Name="findButton" Classes="command" Content="Find..."
                        ToolTip.Tip="Search for text in tag, scripts, and other fields. Ctrl+F"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EAED" BorderBrush="#DADCE0" BorderThickness="0,1,0,0" Padding="8,4" Height="24">
            <TextBlock Name="statusText" Text="Module Info" VerticalAlignment="Center" HorizontalAlignment="Left"
                       TextTrimming="CharacterEllipsis" FontSize="10"/>
        </Border>

        <!-- Main: two columns, no wasted space -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="8">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="8" RowSpacing="8">
                <!-- Left column: Basic Information + Entry Point -->
                <StackPanel Grid.Column="0" Spacing="8">
                    <Border Classes="panel" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="Basic Information"/>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Module Name:" VerticalAlignment="Center" Foreground="#202124"/>
                                <w:LocalizedStringEdit Name="NameEdit" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tag:" VerticalAlignment="Center" Foreground="#202124"/>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Name="TagEdit" Grid.Column="0"/>
                                    <Button Name="TagGenerateButton" Grid.Column="1" Classes="command" Content="Generate"/>
                                </Grid>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="VO ID:" VerticalAlignment="Center" Foreground="#202124"/>
                                <TextBox Name="VoIdEdit" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Hak:" VerticalAlignment="Center" Foreground="#202124"/>
                                <TextBox Name="HakEdit" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Description:" VerticalAlignment="Center" Foreground="#202124"/>
                                <w:LocalizedStringEdit Name="DescEdit" Grid.Row="4" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="Entry Point"/>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Area ResRef:" VerticalAlignment="Center" Foreground="#202124"/>
                                <TextBox Name="EntryResrefEdit" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Entry X:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="EntryXSpin" Grid.Row="1" Grid.Column="1" Minimum="-99999" Maximum="99999" Increment="0.1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Entry Y:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="EntryYSpin" Grid.Row="2" Grid.Column="1" Minimum="-99999" Maximum="99999" Increment="0.1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Entry Z:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="EntryZSpin" Grid.Row="3" Grid.Column="1" Minimum="-99999" Maximum="99999" Increment="0.1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Entry Direction:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="EntryDirSpin" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="360" Increment="1" FormatString="0.##"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column: Time Settings + Scripts -->
                <StackPanel Grid.Column="1" Spacing="8">
                    <Border Classes="panel" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="Time Settings"/>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dawn Hour:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="DawnHourSpin" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="23"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dusk Hour:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="DuskHourSpin" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="23"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Time Scale:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="TimeScaleSpin" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Start Month:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="StartMonthSpin" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Start Day:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="StartDaySpin" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="31"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Start Hour:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="StartHourSpin" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="23"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Start Year:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="StartYearSpin" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="9999"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="XP Scale:" VerticalAlignment="Center" Foreground="#202124"/>
                                <NumericUpDown Name="XpScaleSpin" Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="100"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="Scripts"/>
                            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="scriptPanel" Spacing="4"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
