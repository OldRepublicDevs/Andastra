<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OdyTools.Editors.OdyToolTLK"
        Title="OdyToolTLK"
        MinWidth="400" MinHeight="300"
        Width="560" Height="620"
        RequestedThemeVariant="Light">
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="#F3F5F9" />
        </Style>
        <Style Selector="Menu">
            <Setter Property="Background" Value="#F1F3F4" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="BorderBrush" Value="#D7DBE6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="#202124" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#202124" />
        </Style>
        <Style Selector="ContextMenu MenuItem">
            <Setter Property="Foreground" Value="#202124" />
        </Style>
    </Window.Styles>
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Name="actionNew" />
                <MenuItem Header="_Open" Name="actionOpen" />
                <MenuItem Header="_Save" Name="actionSave" HotKey="Ctrl+S" />
                <MenuItem Header="Save _As" Name="actionSaveAs" />
                <Separator />
                <MenuItem Header="_Revert" Name="actionRevert" />
                <Separator />
                <MenuItem Header="E_xit" Name="actionExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Name="actionUndo" HotKey="Ctrl+Z" />
                <MenuItem Header="_Redo" Name="actionRedo" HotKey="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Find..." Name="actionFind" HotKey="Ctrl+F" />
                <MenuItem Header="_Replace..." Name="actionReplace" HotKey="Ctrl+H" />
                <MenuItem Header="Find _Next" Name="actionFindNext" HotKey="F3" />
                <Separator />
                <MenuItem Header="_Insert Entry" Name="actionInsert" HotKey="Ctrl+I" />
                <MenuItem Header="_Delete Entry" Name="actionDeleteEntry" HotKey="Delete" />
                <Separator />
                <MenuItem Header="_Go To Entry..." Name="actionGoTo" HotKey="Ctrl+G" />
            </MenuItem>
            <MenuItem Header="_Language" Name="menuLanguage">
                <MenuItem Header="Auto-detect (from file)" Name="actionLangAutoDetect" />
                <Separator />
                <MenuItem Header="English" Name="actionLangEnglish" />
                <MenuItem Header="Français" Name="actionLangFrench" />
                <MenuItem Header="Deutsch" Name="actionLangGerman" />
                <MenuItem Header="Italiano" Name="actionLangItalian" />
                <MenuItem Header="Español" Name="actionLangSpanish" />
                <MenuItem Header="Polski" Name="actionLangPolish" />
                <Separator />
                <MenuItem Header="中文（简体）" Name="actionLangChineseSimplified" />
                <MenuItem Header="中文（繁體）" Name="actionLangChineseTraditional" />
                <MenuItem Header="日本語" Name="actionLangJapanese" />
                <MenuItem Header="한국어" Name="actionLangKorean" />
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <!-- Search Box -->
            <Border Name="searchBox" Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7DBE6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="8,6,8,6" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="searchEdit" Grid.Column="0" Watermark="Search text or sound..." Margin="0,0,5,0" />
                    <Button Name="searchButton" Grid.Column="1" Content="Search" Width="70" />
                </Grid>
            </Border>

            <!-- Jump Box -->
            <Border Name="jumpBox" Grid.Row="1" Background="#FFFFFF" BorderBrush="#D7DBE6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="8,0,8,6" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="Go To Entry:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <NumericUpDown Name="jumpSpinbox" Grid.Column="1" Minimum="0" Maximum="0" Margin="0,0,5,0" />
                    <Button Name="jumpButton" Grid.Column="2" Content="Go" Width="70" />
                </Grid>
            </Border>

            <!-- Talk Table: StringRef (#), Text, Sound columns - columns built in code to avoid compiled binding issues -->
            <DataGrid Name="talkTable" Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Insert Entry" Name="ctxInsert" />
                        <MenuItem Header="_Delete Entry" Name="ctxDeleteEntry" />
                        <Separator />
                        <MenuItem Header="_Find..." Name="ctxFind" />
                        <MenuItem Header="_Go To Entry..." Name="ctxGoTo" />
                        <Separator />
                        <MenuItem Header="Find _LocalizedString references" Name="ctxFindReferences" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- Bottom Panel -->
            <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="5">
                <TextBox Name="textEdit" Grid.Row="0" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,5" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                    <TextBlock Text="Sound ResRef:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBox Name="soundEdit" Grid.Column="1" MaxLength="16" />
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="4" Padding="8,4" Background="#E8EAED" BorderBrush="#DADCE0" BorderThickness="0,1,0,0">
                <TextBlock Name="statusText" Text="0 entries" VerticalAlignment="Center" Foreground="#202124" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
