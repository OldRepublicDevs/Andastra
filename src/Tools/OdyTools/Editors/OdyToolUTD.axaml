<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:OdyTools.Widgets.Edit"
        xmlns:w="clr-namespace:OdyTools.Widgets"
        x:Class="OdyTools.Editors.OdyToolUTD"
        Title="OdyToolUTD"
        MinWidth="700" MinHeight="500"
        Width="900" Height="600"
        RequestedThemeVariant="Light">
  <Window.Styles>
    <Style Selector="Window">
      <Setter Property="Background" Value="#F3F5F9" />
    </Style>
  </Window.Styles>
  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top" Name="menuBar">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Name="actionNew"/>
        <MenuItem Header="_Open" Name="actionOpen"/>
        <MenuItem Header="_Save" Name="actionSave"/>
        <MenuItem Header="Save _As" Name="actionSaveAs"/>
        <Separator/>
        <MenuItem Header="_Revert" Name="actionRevert"/>
        <Separator/>
        <MenuItem Header="E_xit" Name="actionExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Name="actionUndo"/>
        <MenuItem Header="_Redo" Name="actionRedo"/>
        <Separator/>
        <MenuItem Header="Find..." Name="actionFind"/>
        <MenuItem Header="Find _Next" Name="actionFindNext"/>
      </MenuItem>
      <MenuItem Header="_Help" Name="menuHelp"/>
    </Menu>

    <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="8" Spacing="4">
        <!-- Basic -->
        <Expander Header="Basic" IsExpanded="True">
          <StackPanel Spacing="6">
            <TextBlock Text="Name:"/>
            <w:LocalizedStringEdit Name="nameEdit"/>
            <TextBlock Text="Tag:"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="tagEdit"/>
              <Button Name="tagGenerateBtn" Content="Generate"/>
            </StackPanel>
            <TextBlock Text="ResRef:"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="resrefEdit"/>
              <Button Name="resrefGenerateBtn" Content="Generate"/>
            </StackPanel>
            <TextBlock Text="Appearance:"/>
            <widgets:ComboBox2DA Name="appearanceSelect"/>
            <TextBlock Text="Conversation:"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox Name="conversationEdit" IsEditable="True"/>
              <Button Name="conversationModifyBtn" Content="Edit"/>
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- Advanced -->
        <Expander Header="Advanced" IsExpanded="False">
          <StackPanel Spacing="4">
            <CheckBox Name="min1HpCheckbox" Content="Min 1 HP"/>
            <CheckBox Name="plotCheckbox" Content="Plot"/>
            <CheckBox Name="staticCheckbox" Content="Static"/>
            <CheckBox Name="notBlastableCheckbox" Content="Not Blastable"/>
            <TextBlock Text="Faction:"/>
            <widgets:ComboBox2DA Name="factionSelect"/>
            <TextBlock Text="Animation State:"/>
            <NumericUpDown Name="animationStateSpin" Minimum="0" Maximum="255"/>
            <TextBlock Text="Current HP:"/>
            <NumericUpDown Name="currentHpSpin" Minimum="0" Maximum="32767"/>
            <TextBlock Text="Maximum HP:"/>
            <NumericUpDown Name="maxHpSpin" Minimum="0" Maximum="32767"/>
            <TextBlock Text="Hardness:"/>
            <NumericUpDown Name="hardnessSpin" Minimum="0" Maximum="255"/>
            <TextBlock Text="Fortitude:"/>
            <NumericUpDown Name="fortitudeSpin" Minimum="0" Maximum="255"/>
            <TextBlock Text="Reflex:"/>
            <NumericUpDown Name="reflexSpin" Minimum="0" Maximum="255"/>
            <TextBlock Text="Willpower:"/>
            <NumericUpDown Name="willSpin" Minimum="0" Maximum="255"/>
          </StackPanel>
        </Expander>

        <!-- Lock -->
        <Expander Header="Lock" IsExpanded="False">
          <StackPanel Spacing="4">
            <CheckBox Name="needKeyCheckbox" Content="Key Required"/>
            <CheckBox Name="removeKeyCheckbox" Content="Auto Remove Key"/>
            <TextBlock Text="Key Name:"/>
            <TextBox Name="keyEdit"/>
            <CheckBox Name="lockedCheckbox" Content="Locked"/>
            <TextBlock Text="Unlock DC:"/>
            <NumericUpDown Name="openLockSpin" Minimum="0" Maximum="255"/>
            <TextBlock Text="Unlock Difficulty:"/>
            <NumericUpDown Name="difficultySpin" Minimum="0" Maximum="255"/>
            <TextBlock Text="Unlock Difficulty Mod:"/>
            <NumericUpDown Name="difficultyModSpin" Minimum="-128" Maximum="127"/>
          </StackPanel>
        </Expander>

        <!-- Scripts -->
        <Expander Header="Scripts" IsExpanded="False">
          <StackPanel Spacing="4">
            <TextBlock Text="OnClick:"/>
            <ComboBox Name="onclickEdit" IsEditable="True"/>
            <TextBlock Text="OnClosed:"/>
            <ComboBox Name="onclosedEdit" IsEditable="True"/>
            <TextBlock Text="OnDamaged:"/>
            <ComboBox Name="ondamagedEdit" IsEditable="True"/>
            <TextBlock Text="OnDeath:"/>
            <ComboBox Name="ondeathEdit" IsEditable="True"/>
            <TextBlock Text="OnOpenFailed:"/>
            <ComboBox Name="onopenfailedEdit" IsEditable="True"/>
            <TextBlock Text="OnHeartbeat:"/>
            <ComboBox Name="onheartbeatEdit" IsEditable="True"/>
            <TextBlock Text="OnMelee:"/>
            <ComboBox Name="onmeleeEdit" IsEditable="True"/>
            <TextBlock Text="OnOpen:"/>
            <ComboBox Name="onopenEdit" IsEditable="True"/>
            <TextBlock Text="OnUnlock:"/>
            <ComboBox Name="onunlockEdit" IsEditable="True"/>
            <TextBlock Text="OnUserDefined:"/>
            <ComboBox Name="onuserdefinedEdit" IsEditable="True"/>
            <TextBlock Text="OnPower:"/>
            <ComboBox Name="onpowerEdit" IsEditable="True"/>
          </StackPanel>
        </Expander>

        <!-- Comments -->
        <Expander Header="Comments" IsExpanded="False">
          <StackPanel Spacing="4">
            <TextBlock Text="Comment:"/>
            <TextBox Name="commentsEdit" AcceptsReturn="True" AcceptsTab="True"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Border DockPanel.Dock="Bottom" Padding="4,2" Background="#E8EAED">
      <TextBlock Name="statusText" Text="Door"/>
    </Border>
  </DockPanel>
</Window>
