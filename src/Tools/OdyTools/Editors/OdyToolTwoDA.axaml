<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OdyTools.Editors.OdyToolTwoDA"
        Title="2DA Editor"
        MinWidth="640" MinHeight="420"
        Width="1320" Height="820">
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="#F3F5F9" />
        </Style>
        <Style Selector="Menu">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DBE6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Button.command">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.command:pointerover">
            <Setter Property="Background" Value="#E8EAED" />
        </Style>
        <Style Selector="Button.command.primary">
            <Setter Property="Background" Value="#1A73E8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.command.primary:pointerover">
            <Setter Property="Background" Value="#1765CC" />
        </Style>
        <Style Selector="Button.sidebarCmd">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.sidebarCmd:pointerover">
            <Setter Property="Background" Value="#E8EAED" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DBE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="DataGrid#twodaTable">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DBE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E8F1" />
            <Setter Property="VerticalGridLinesBrush" Value="#E4E8F1" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserReorderColumns" Value="True" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="HeadersVisibility" Value="All" />
        </Style>
        <!-- Cell-only selection: hide full-row selection background so only the current cell shows focus -->
        <Style Selector="DataGrid#twodaTable DataGridRow:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="DataGrid#twodaTable DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="DataGrid#twodaTable DataGridCell">
            <Setter Property="Padding" Value="2,0,2,0" />
            <Setter Property="MinHeight" Value="20" />
        </Style>
        <!-- Emphasize the current cell so it reads as the single selected cell -->
        <Style Selector="DataGrid#twodaTable DataGridCell:focus">
            <Setter Property="Background" Value="#E3F2FD" />
        </Style>
        <Style Selector="DataGrid#twodaTable DataGridCell:current">
            <Setter Property="Background" Value="#E3F2FD" />
        </Style>
        <Style Selector="DataGrid#twodaTable DataGridColumnHeader">
            <Setter Property="Padding" Value="2,0,2,0" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="Button#addColumnButton">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button#addColumnButton:pointerover">
            <Setter Property="Background" Value="#16a34a" />
        </Style>
        <Style Selector="Button#addColumnButton:pressed">
            <Setter Property="Background" Value="#15803d" />
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Name="actionNew" />
                <MenuItem Header="_Open" Name="actionOpen" />
                <MenuItem Header="_Save" Name="actionSave" HotKey="Ctrl+S" />
                <MenuItem Header="Save _As" Name="actionSaveAs" />
                <MenuItem Header="Save As _2DA (binary)..." Name="actionSaveAs2DA" />
                <MenuItem Header="Save As _CSV..." Name="actionSaveAsCSV" />
                <Separator />
                <MenuItem Header="_Revert" Name="actionRevert" />
                <Separator />
                <MenuItem Header="E_xit" Name="actionExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Name="actionUndo" HotKey="Ctrl+Z" />
                <MenuItem Header="_Redo" Name="actionRedo" HotKey="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Cut" Name="actionCut" HotKey="Ctrl+X" />
                <MenuItem Header="_Copy" Name="actionCopy" HotKey="Ctrl+C" />
                <MenuItem Header="_Paste" Name="actionPaste" HotKey="Ctrl+V" />
                <MenuItem Header="Paste _Transposed" Name="actionPasteTransposed" />
                <MenuItem Header="_Clear Cell" Name="actionClearCell" />
                <Separator />
                <MenuItem Header="_Find..." Name="actionFind" HotKey="Ctrl+F" />
                <MenuItem Header="_Replace..." Name="actionReplace" HotKey="Ctrl+H" />
                <Separator />
                <MenuItem Header="Go _to Row..." Name="actionGoToRow" HotKey="Ctrl+G" />
                <Separator />
                <MenuItem Header="Select _All" Name="actionSelectAll" HotKey="Ctrl+A" />
                <MenuItem Header="Select _Column" Name="actionSelectColumn" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Toggle _Filter" Name="actionToggleFilter" />
                <Separator />
                <MenuItem Header="_Insert Row" Name="actionInsertRow" />
                <MenuItem Header="Insert Row _Above" Name="actionInsertRowAbove" />
                <MenuItem Header="Insert Row _Below" Name="actionInsertRowBelow" />
                <MenuItem Header="Insert _Multiple Rows..." Name="actionInsertRows" />
                <MenuItem Header="_Duplicate Row" Name="actionDuplicateRow" />
                <MenuItem Header="_Remove Rows (Shift+Del)" Name="actionRemoveRows" HotKey="Shift+Delete" />
                <MenuItem Header="Move Row _Up" Name="actionMoveRowUp" HotKey="Alt+Up" />
                <MenuItem Header="Move Row D_own" Name="actionMoveRowDown" HotKey="Alt+Down" />
                <MenuItem Header="_Fill Down" Name="actionFillDown" HotKey="Ctrl+D" />
                <Separator />
                <MenuItem Header="_Add Column..." Name="actionAddColumn" />
                <MenuItem Header="_Rename Column..." Name="actionRenameColumn" />
                <MenuItem Header="_Remove Column" Name="actionRemoveColumn" />
                <MenuItem Header="Move Column _Left" Name="actionMoveColumnLeft" HotKey="Ctrl+Shift+Left" />
                <MenuItem Header="Move Column _Right" Name="actionMoveColumnRight" HotKey="Ctrl+Shift+Right" />
                <Separator />
                <MenuItem Header="Sort _A-Z" Name="actionSortAsc" />
                <MenuItem Header="Sort _Z-A" Name="actionSortDesc" />
                <Separator />
                <MenuItem Header="_Redo Row Labels" Name="actionRedoRowLabels" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle _Sidebar" Name="actionToggleSidebar" HotKey="F9" />
                <MenuItem Header="Set Row _Header" Name="actionRowHeaderMenu">
                    <MenuItem Header="Row index" Name="actionRowHeaderIndex" />
                    <MenuItem Header="Row label" Name="actionRowHeaderLabel" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Formula bar: compact -->
        <Border DockPanel.Dock="Top" Padding="4,3" Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="0,0,0,1" MinHeight="28">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="0">
                <Border Name="nameBoxBorder" Grid.Column="0" MinWidth="72" MaxWidth="112" Background="#F1F3F4" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="0" Padding="4,2" Margin="0,0,1,0">
                    <TextBlock Name="cellAddressText" Text="—" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" TextAlignment="Center" />
                </Border>
                <Border Grid.Column="1" Width="20" Background="#EEF0F2" BorderBrush="#DADCE0" BorderThickness="1,1,0,1" CornerRadius="0" Padding="0" Margin="0">
                    <TextBlock Text="fx" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" FontStyle="Italic" Foreground="#5F6368" />
                </Border>
                <TextBox Name="formulaBarEdit" Grid.Column="2" Watermark="Enter value (Enter to apply)" VerticalAlignment="Center" Padding="4,2" BorderThickness="1" FontSize="11" MinHeight="0" />
            </Grid>
        </Border>

        <!-- Status bar: bottom of window, single horizontal line, minimal height (must be before Grid so DockPanel gives fill to Grid) -->
        <Border DockPanel.Dock="Bottom" Background="#E8EAED" BorderBrush="#DADCE0" BorderThickness="0,1,0,0" Padding="6,2" Height="20">
            <TextBlock Name="statusText" Text="Ready | 0 rows × 0 columns" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#5F6368" />
        </Border>

        <Grid Name="mainLayoutGrid" Margin="6" ColumnDefinitions="Auto,*" ColumnSpacing="6" RowDefinitions="*">
            <!-- Left sidebar: tools and navigation -->
            <Border Name="sidebarHost" Grid.Column="0" Width="176" MinWidth="160" MaxWidth="220">
                <Border Name="sidebarPanel"
                        Background="#FAFBFC" BorderBrush="#E1E5EB" BorderThickness="0,0,1,0"
                        Padding="0" CornerRadius="4">
                    <StackPanel Spacing="0" Margin="0,2,0,0">
                        <!-- Search: single canonical filter -->
                        <Border Name="filterSection" Padding="8,6,8,6" Background="#FFFFFF" BorderBrush="#E8EAED" BorderThickness="0,0,0,1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Search" FontWeight="SemiBold" FontSize="10" Foreground="#3C4043" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <TextBox Name="filterEdit" Grid.Column="0" Watermark="Search rows..." Padding="4,2" MinHeight="0" FontSize="11" />
                                    <Button Name="tbClearFilter" Grid.Column="1" Classes="command" Content="Clear" Padding="6,4" VerticalAlignment="Stretch" ToolTip.Tip="Clear search" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Stats summary -->
                        <Border Padding="8,6" Background="Transparent">
                            <TextBlock Name="sidebarStatsText" Text="—" FontSize="10" Foreground="#5F6368" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- Selection -->
                        <Border Padding="8,4" Background="Transparent">
                            <StackPanel Spacing="2">
                                <TextBlock Text="SELECTION" FontSize="9" FontWeight="SemiBold" Foreground="#5F6368" Margin="0,0,0,1" />
                                <Button Name="tbSelectAll" Classes="sidebarCmd" Content="Select All" HorizontalAlignment="Stretch" ToolTip.Tip="Ctrl+A" />
                                <Button Name="tbSelectColumn" Classes="sidebarCmd" Content="Select Column" HorizontalAlignment="Stretch" ToolTip.Tip="Select current column" />
                                <Button Name="tbFillDown" Classes="sidebarCmd" Content="Fill Down" HorizontalAlignment="Stretch" ToolTip.Tip="Ctrl+D" />
                                <Button Name="tbGoToRow" Classes="sidebarCmd" Content="Go to Row…" HorizontalAlignment="Stretch" ToolTip.Tip="Ctrl+G" />
                            </StackPanel>
                        </Border>

                        <!-- Rows -->
                        <Border Padding="8,4" Background="Transparent">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ROWS" FontSize="9" FontWeight="SemiBold" Foreground="#5F6368" Margin="0,0,0,1" />
                                <Button Name="tbInsertRowSidebar" Classes="sidebarCmd" Content="Insert Row" HorizontalAlignment="Stretch" ToolTip.Tip="Insert row" />
                                <Button Name="tbInsertRowAbove" Classes="sidebarCmd" Content="Insert Above" HorizontalAlignment="Stretch" ToolTip.Tip="Insert row above selection" />
                                <Button Name="tbInsertRowBelow" Classes="sidebarCmd" Content="Insert Below" HorizontalAlignment="Stretch" ToolTip.Tip="Insert row below selection" />
                                <Button Name="tbDuplicateRow" Classes="sidebarCmd" Content="Duplicate Row" HorizontalAlignment="Stretch" ToolTip.Tip="Duplicate selected row(s)" />
                                <Button Name="tbRemoveRowsSidebar" Classes="sidebarCmd" Content="Delete Rows" HorizontalAlignment="Stretch" ToolTip.Tip="Shift+Del" />
                                <Button Name="tbMoveRowUpSidebar" Classes="sidebarCmd" Content="Move Row Up" HorizontalAlignment="Stretch" ToolTip.Tip="Alt+Up" />
                                <Button Name="tbMoveRowDownSidebar" Classes="sidebarCmd" Content="Move Row Down" HorizontalAlignment="Stretch" ToolTip.Tip="Alt+Down" />
                            </StackPanel>
                        </Border>

                        <!-- Columns -->
                        <Border Padding="8,4" Background="Transparent">
                            <StackPanel Spacing="2">
                                <TextBlock Text="COLUMNS" FontSize="9" FontWeight="SemiBold" Foreground="#5F6368" Margin="0,0,0,1" />
                                <Button Name="tbAddColumnSidebar" Classes="sidebarCmd" Content="Add Column" HorizontalAlignment="Stretch" ToolTip.Tip="Add column" />
                                <Button Name="tbRenameColumn" Classes="sidebarCmd" Content="Rename Column" HorizontalAlignment="Stretch" ToolTip.Tip="Rename current column" />
                                <Button Name="tbRemoveColumnSidebar" Classes="sidebarCmd" Content="Remove Column" HorizontalAlignment="Stretch" ToolTip.Tip="Remove current column" />
                                <Button Name="tbMoveColumnLeftSidebar" Classes="sidebarCmd" Content="Move Column Left" HorizontalAlignment="Stretch" ToolTip.Tip="Ctrl+Shift+Left" />
                                <Button Name="tbMoveColumnRightSidebar" Classes="sidebarCmd" Content="Move Column Right" HorizontalAlignment="Stretch" ToolTip.Tip="Ctrl+Shift+Right" />
                                <Button Name="tbRedoRowLabels" Classes="sidebarCmd" Content="Regen Row Labels" HorizontalAlignment="Stretch" ToolTip.Tip="Redo row header column" />
                            </StackPanel>
                        </Border>

                        <!-- Sort -->
                        <Border Padding="8,4" Background="Transparent">
                            <StackPanel Spacing="2">
                                <TextBlock Text="SORT" FontSize="9" FontWeight="SemiBold" Foreground="#5F6368" Margin="0,0,0,1" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <Button Name="tbSortAscSidebar" Grid.Column="0" Classes="sidebarCmd" Content="A → Z" HorizontalAlignment="Stretch" ToolTip.Tip="Sort ascending" />
                                    <Button Name="tbSortDescSidebar" Grid.Column="1" Classes="sidebarCmd" Content="Z → A" HorizontalAlignment="Stretch" ToolTip.Tip="Sort descending" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Shortcuts reference -->
                        <Border Padding="8,6" Background="#F1F3F4" CornerRadius="0,0,4,4">
                            <StackPanel Spacing="2">
                                <TextBlock Text="KEYBOARD" FontSize="9" FontWeight="SemiBold" Foreground="#5F6368" Margin="0,0,0,1" />
                                <TextBlock TextWrapping="Wrap" Foreground="#5F6368" FontSize="9" LineHeight="13"
                                           Text="F2 edit cell · F3 find next · F9 sidebar&#x0a;Home/End row · Ctrl+Home/End jump&#x0a;PgUp/PgDn scroll · Alt+↑↓ move row&#x0a;Shift+Arrow extend select · Esc refocus&#x0a;Ctrl+L search · Ctrl+E formula bar" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>

            <Border Name="gridHost" Classes="panel" Grid.Column="1" Padding="0" MinHeight="150">
                <Grid RowDefinitions="*">
                    <DataGrid Name="twodaTable" Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="False">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="_Cut" Name="ctxCut" />
                                <MenuItem Header="_Copy" Name="ctxCopy" />
                                <MenuItem Header="_Paste" Name="ctxPaste" />
                                <MenuItem Header="Paste _Transposed" Name="ctxPasteTransposed" />
                                <MenuItem Header="_Clear Cell" Name="ctxClearCell" />
                                <Separator />
                                <MenuItem Header="_Insert Row" Name="ctxInsertRow" />
                                <MenuItem Header="Insert Row _Above" Name="ctxInsertRowAbove" />
                                <MenuItem Header="Insert Row _Below" Name="ctxInsertRowBelow" />
                                <MenuItem Header="Insert _Multiple Rows..." Name="ctxInsertRows" />
                                <MenuItem Header="_Duplicate Row" Name="ctxDuplicateRow" />
                                <MenuItem Header="_Remove Rows" Name="ctxRemoveRows" />
                                <MenuItem Header="Move Row _Up" Name="ctxMoveRowUp" />
                                <MenuItem Header="Move Row D_own" Name="ctxMoveRowDown" />
                                <MenuItem Header="_Fill Down" Name="ctxFillDown" />
                                <Separator />
                                <MenuItem Header="_Rename Column..." Name="ctxRenameColumn" />
                                <MenuItem Header="Move Column _Left" Name="ctxMoveColumnLeft" />
                                <MenuItem Header="Move Column _Right" Name="ctxMoveColumnRight" />
                                <Separator />
                                <MenuItem Header="Sort _A-Z" Name="ctxSortAsc" />
                                <MenuItem Header="Sort _Z-A" Name="ctxSortDesc" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <!-- Empty state: only when zero rows (e.g. after loading empty file). New() starts with 1 row so user can click and type. -->
                    <Border Name="emptyStateOverlay" Grid.Row="0" IsHitTestVisible="False"
                            Background="#FAFBFC" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Name="emptyStateText" Text="No rows — Add rows (Tools → Insert Row) or open a file (File → Open)."
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#5C6370" FontSize="13" LineHeight="20" />
                    </Border>
                    <!-- Add column: green + overlay button, 5px right of grid, undo/redo supported -->
                    <Button Name="addColumnButton" Grid.Row="0"
                            Width="36" Height="32" MinWidth="32"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,5,0" Padding="0"
                            Background="#22c55e" Foreground="White"
                            FontSize="18" FontWeight="Bold"
                            BorderThickness="0"
                            ToolTip.Tip="Add column (Ctrl+Z to undo)"
                            Cursor="Hand"
                            Content="+" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
