<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared props for slim editor standalones: Avalonia + BioWare only, no OdyTools project ref.
  Import this file from each *Standalone.csproj. Set these properties BEFORE importing (or accept defaults):
    OdyToolsStandaloneDefine     - required, e.g. ARE_STANDALONE
    OdyToolsStandaloneStartupObject - optional, default OdyTools.Editors.Standalone.EditorStandaloneHost.EditorStandaloneProgram
    OdyToolsStandaloneTargetFrameworks - optional, default net9.0;net48
    OdyToolsStandaloneBioWareRef - optional, default ..\..\..\BioWare (DLG uses ..\..\..\..\BioWare)
    OdyToolsStandaloneAppConfig  - optional, default $(MSBuildProjectDirectory)\app.config (DLG uses $(MSBuildProjectDirectory)\..\app.config)
    _OdyToolsRoot                - required, OdyTools root path (Editors: GetDirectoryName(MSBuildProjectDirectory), DLG: GetDirectoryName twice)
-->
<Project>
  <!-- Defaults for project-specific properties (set before Import to override) -->
  <PropertyGroup>
    <OdyToolsStandaloneStartupObject Condition="'$(OdyToolsStandaloneStartupObject)' == ''">OdyTools.Editors.Standalone.EditorStandaloneHost.EditorStandaloneProgram</OdyToolsStandaloneStartupObject>
    <OdyToolsStandaloneTargetFrameworks Condition="'$(OdyToolsStandaloneTargetFrameworks)' == ''">net9.0;net48</OdyToolsStandaloneTargetFrameworks>
    <OdyToolsStandaloneBioWareRef Condition="'$(OdyToolsStandaloneBioWareRef)' == ''">..\..\..\BioWare</OdyToolsStandaloneBioWareRef>
    <OdyToolsStandaloneAppConfig Condition="'$(OdyToolsStandaloneAppConfig)' == ''">$(MSBuildProjectDirectory)\app.config</OdyToolsStandaloneAppConfig>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Platforms>x86;x64;arm64</Platforms>
    <UseAppHost>true</UseAppHost>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaCopyWin32Dll>false</AvaloniaCopyWin32Dll>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <NoWin32Manifest>true</NoWin32Manifest>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <TargetFrameworks>$(OdyToolsStandaloneTargetFrameworks)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants Condition="'$(OdyToolsStandaloneDefine)' != ''">$(DefineConstants);$(OdyToolsStandaloneDefine)</DefineConstants>
    <StartupObject>$(OdyToolsStandaloneStartupObject)</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(_OdyToolsRoot)\Utils\AutosaveService.cs" />
    <Compile Include="$(_OdyToolsRoot)\Utils\AtomicFileWriter.cs" />
    <Compile Include="$(_OdyToolsRoot)\Utils\BackupRotator.cs" />
    <Compile Include="$(_OdyToolsRoot)\Utils\DialogHelper.cs" />
    <Compile Include="$(_OdyToolsRoot)\Widgets\Edit\ComboBox2DA.axaml.cs" />
    <Compile Include="$(_OdyToolsRoot)\Widgets\IMediaPlayer.cs" />
    <Compile Include="$(_OdyToolsRoot)\Widgets\NAudioMediaPlayer.cs" />
    <Compile Include="$(_OdyToolsRoot)\Editors\TwoDA\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Include="$(_OdyToolsRoot)\Widgets\Edit\ComboBox2DA.axaml" />
  </ItemGroup>

  <!-- OutputType: WinExe for Windows, Exe for cross-platform RID -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)'=='' OR $(RuntimeIdentifier.StartsWith('win'))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="!$(RuntimeIdentifier.StartsWith('win')) AND '$(RuntimeIdentifier)'!=''">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Debug: Exe for console; Release: WinExe -->
  <PropertyGroup>
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>
  </PropertyGroup>

  <!-- net48 binding redirects -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AppConfig>$(OdyToolsStandaloneAppConfig)</AppConfig>
  </PropertyGroup>

  <Target Name="ForceStandaloneExe" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
      <OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>
    </PropertyGroup>
  </Target>

  <!-- Avalonia 11 for both net9.0 and net48 (Avalonia 10.x not on NuGet). net48 uses lib to avoid CoreLib refs. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.11" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.3.1.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <!-- net48: extra packages and force use of implementation (lib) not ref to avoid System.Private.CoreLib -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="NETStandard.Library" Version="2.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <!-- net48: use Avalonia lib (netstandard2.0) for compile, strip package refs that point to CoreLib -->
  <Target Name="UseAvaloniaLibForNet48" AfterTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' == 'net48'">
    <PropertyGroup>
      <_AvaloniaLibPath>$(NuGetPackageRoot)avalonia\11.3.11\lib\netstandard2.0\</_AvaloniaLibPath>
    </PropertyGroup>
    <ItemGroup>
      <ReferencePath Include="$(_AvaloniaLibPath)Avalonia.Base.dll" />
      <ReferencePath Include="$(_AvaloniaLibPath)Avalonia.Controls.dll" />
      <ReferencePath Include="$(_AvaloniaLibPath)Avalonia.DesignerSupport.dll" />
      <ReferencePath Include="$(_AvaloniaLibPath)Avalonia.Dialogs.dll" />
      <ReferencePath Include="$(_AvaloniaLibPath)Avalonia.Markup.Xaml.dll" />
      <ReferencePath Include="$(_AvaloniaLibPath)Avalonia.Markup.dll" />
      <ReferencePath Include="$(_AvaloniaLibPath)Avalonia.Metal.dll" />
      <ReferencePath Include="$(_AvaloniaLibPath)Avalonia.OpenGL.dll" />
      <ReferencePath Include="$(_AvaloniaLibPath)Avalonia.Vulkan.dll" />
    </ItemGroup>
    <ItemGroup>
      <!-- Keep framework refs (ReferenceAssemblies path); strip all other package ref to avoid CoreLib type forwards -->
      <ReferencePath Remove="%(ReferencePath.Identity)" Condition="$([System.String]::Copy('%(ReferencePath.FullPath)').Contains('\ref\')) and $([System.String]::Copy('%(ReferencePath.FullPath)').Contains('packages')) and !$([System.String]::Copy('%(ReferencePath.FullPath)').ToLower().Contains('referenceassemblies'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="Markdig" Version="0.44.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
  </ItemGroup>

  <!-- BioWare project reference (path overridden via OdyToolsStandaloneBioWareRef) -->
  <ItemGroup>
    <ProjectReference Include="$(OdyToolsStandaloneBioWareRef)\BioWare.csproj" />
  </ItemGroup>
</Project>
