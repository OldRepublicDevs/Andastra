<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <Platforms>x86;x64;arm64</Platforms>
    <UseAppHost>true</UseAppHost>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <TargetFrameworks>net9.0;net48</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>WinExe</OutputType>
    <Nullable>disable</Nullable>
    <AvaloniaCopyWin32Dll>false</AvaloniaCopyWin32Dll>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <NoWin32Manifest>true</NoWin32Manifest>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AssemblyName>OdyTools.Standalone</AssemblyName>
    <RootNamespace>OdyTools</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject>OdyTools.Editors.Standalone.EditorStandaloneHost.EditorStandaloneProgram</StartupObject>
  </PropertyGroup>
  <!-- Exclude main toolset entry so this project has a single Main -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="App.axaml.cs" />
    <!-- Exclude per-editor standalone entry points (use unified host only) -->
    <Compile Remove="Editors\Standalone\OdyTool2DA\**" />
    <Compile Remove="Dialogs\InsertInstanceDialog.axaml.cs" />
  </ItemGroup>
  <!-- Keep the unified standalone XAML set explicit. Default Avalonia globbing
       also picks up main-app and dialog/theme XAML whose backing types are
       intentionally excluded from this launcher project. -->
  <ItemGroup>
    <AvaloniaXaml Remove="**/*.axaml" />
    <AvaloniaXaml Remove="**\*.axaml" />
    <AvaloniaXaml Include="Editors/Standalone/EditorStandaloneHost/EditorStandaloneApp.axaml" />
    <AvaloniaXaml Include="Editors/OdyTool2DA.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolARE.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolBWM.axaml" />
    <AvaloniaXaml Include="Editors/DLG/OdyToolDLG.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolERF.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolFAC.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolGFF.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolGIT.axaml" />
    <AvaloniaXaml Include="Editors/GUI/OdyToolGUI.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolIFO.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolJRL.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolLIP.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolLTR.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolLYT.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolMDL.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolNSS.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolPTH.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolSAV.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolSSF.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolTLK.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolTPC.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolTXT.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTC.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTC_ScriptsTab.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTD.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTE.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTI.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTM.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTP.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTS.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTT.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolUTW.axaml" />
    <AvaloniaXaml Include="Editors/OdyToolWAV.axaml" />
    <AvaloniaXaml Include="Dialogs/ColorPickerDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/DLGSettingsDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/EditorHelpDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/ExtractOptionsDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/FileResultsDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/LoadFromModuleDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/LocalizedStringDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/PropertyEditorDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/UTCSettingsDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/Edit/DialogAnimationDialog.axaml" />
    <AvaloniaXaml Include="Dialogs/Edit/DialogModelDialog.axaml" />
    <AvaloniaXaml Include="Widgets/Edit/ColorEdit.axaml" />
    <AvaloniaXaml Include="Widgets/Edit/ComboBox2DA.axaml" />
    <AvaloniaXaml Include="Widgets/Edit/GFFFieldSpinBox.axaml" />
    <AvaloniaXaml Include="Widgets/LocalizedStringEdit.axaml" />
    <AvaloniaXaml Include="Widgets/MediaPlayerWidget.axaml" />
    <AvaloniaXaml Include="Widgets/Settings/InstallationsWidget.axaml" />
  </ItemGroup>
  <!-- OutputType -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)'=='' OR $(RuntimeIdentifier.StartsWith('win'))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="!$(RuntimeIdentifier.StartsWith('win')) AND '$(RuntimeIdentifier)'!=''">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' AND ('$(RuntimeIdentifier)'=='' OR $(RuntimeIdentifier.StartsWith('win')))">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <AvaloniaCopyWin32Dll>false</AvaloniaCopyWin32Dll>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <NoWin32Manifest>true</NoWin32Manifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BioWare" Version="1.0.0" />
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="11.3.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.3.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageReference Include="ReactiveUI" Version="22.3.1" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="3.0.4" Condition="'$(TargetFramework)' != 'net48'" />
    <PackageReference Include="NetSparkleUpdater.UI.Avalonia" Version="3.0.4" Condition="'$(TargetFramework)' != 'net48'" />
    <PackageReference Include="Markdig" Version="0.44.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.1" Condition="'$(TargetFramework)' != 'net48'" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BioWare\BioWare.csproj" />
    <ProjectReference Include="..\KotorDiff\KotorDiff.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Compile Remove="Windows\UpdateManager.cs" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Resources\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Data\**" />
    <None Remove="Windows\**" />
    <None Remove="Editors\**" />
    <None Remove="Dialogs\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Data\**" />
    <EmbeddedResource Remove="Windows\**" />
    <EmbeddedResource Remove="Editors\**" />
    <EmbeddedResource Remove="Dialogs\**" />
  </ItemGroup>
</Project>
