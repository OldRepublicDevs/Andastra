<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OdyPatch.UI.Views.RteEditorWindow"
        Title="RTE Editor"
        Width="520"
        Height="220"
        CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <TextBlock Grid.Row="0"
                   Text="The rich text editor is unavailable on .NET Framework (net48)."
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

        <Button Grid.Row="1"
                Content="Close"
                HorizontalAlignment="Right"
                MinWidth="90"
                Margin="0,12,0,0"
                Click="OnCloseEditor"/>
    </Grid>
</Window>
